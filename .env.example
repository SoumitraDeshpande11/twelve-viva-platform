OPENAI_API_KEY=
OPENAI_VIVA_MODEL=gpt-5.5
OPENAI_VIVA_TIMEOUT_SECONDS=45
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_LANGUAGE=en
OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=60
GEMINI_API_KEY=
GEMINI_VIVA_MODEL=gemini-3.5-flash
GEMINI_VIVA_TIMEOUT_SECONDS=45
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIPTION_TIMEOUT_SECONDS=60
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_TIMEOUT_SECONDS=45
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_TOKEN_MINUTES=30
GEMINI_LIVE_NEW_SESSION_SECONDS=60
# Local LLM provider via Ollama (cross-platform: Linux + macOS/Metal). Set
# TWELVE_AI_PROVIDER=ollama to use it for scoring/questions/follow-ups; falls back to
# the deterministic local heuristic on error. Needs a running `ollama serve` + a pulled
# model. For speed use a GPU build (CUDA on Linux, Metal on Apple Silicon).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=180
# Local STT via faster-whisper (TWELVE_TRANSCRIPTION_PROVIDER=whisper). Model downloads
# on first use. WHISPER_DEVICE=cuda + WHISPER_COMPUTE_TYPE=float16 for GPU.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
# Providers: auto | openai | gemini | ollama | local   (transcription also: whisper)
TWELVE_AI_PROVIDER=auto
TWELVE_TRANSCRIPTION_PROVIDER=auto
TWELVE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TWELVE_ENV=local
TWELVE_SECRET_KEY=replace-with-a-long-random-secret
TWELVE_COOKIE_SECURE=false
TWELVE_BOOTSTRAP_ADMIN_EMAIL=
TWELVE_BOOTSTRAP_ADMIN_PASSWORD=
TWELVE_PROVIDER_TOKEN_RATE_PER_MINUTE=4
TWELVE_MAX_AUDIO_BYTES=26214400
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
